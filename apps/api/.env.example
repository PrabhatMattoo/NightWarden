# Copy to apps/api/.env. Every value has a default. A setting named here is locked
# in Settings; one left out is chosen there, and takes the default until it is.

# No default: unset means pick a provider in Settings.
# NIGHTWARDEN_LLM_PROVIDER=openrouter          # anthropic | openai | openrouter | openai-compatible

# Each provider takes _API_KEY, _MODEL, _BASE_URL and _REASONING_LEVEL. A key may
# come from a file as _API_KEY_FILE instead; setting both refuses to start.
# NIGHTWARDEN_OPENROUTER_API_KEY=
# NIGHTWARDEN_OPENROUTER_MODEL=
# NIGHTWARDEN_OPENROUTER_BASE_URL=             # default: https://openrouter.ai/api/v1
# NIGHTWARDEN_OPENROUTER_REASONING_LEVEL=

# NIGHTWARDEN_ANTHROPIC_API_KEY=
# NIGHTWARDEN_ANTHROPIC_MODEL=
# NIGHTWARDEN_ANTHROPIC_BASE_URL=              # default: https://api.anthropic.com/v1
# NIGHTWARDEN_ANTHROPIC_REASONING_LEVEL=

# NIGHTWARDEN_OPENAI_API_KEY=
# NIGHTWARDEN_OPENAI_MODEL=
# NIGHTWARDEN_OPENAI_BASE_URL=                 # default: https://api.openai.com/v1
# NIGHTWARDEN_OPENAI_REASONING_LEVEL=

# Ollama, vLLM, LM Studio or a gateway. The base URL is required, the key is not.
# NIGHTWARDEN_OPENAI_COMPATIBLE_BASE_URL=      # e.g. http://localhost:11434/v1
# NIGHTWARDEN_OPENAI_COMPATIBLE_MODEL=
# NIGHTWARDEN_OPENAI_COMPATIBLE_API_KEY=
# NIGHTWARDEN_OPENAI_COMPATIBLE_REASONING_LEVEL=

# Limits and sandbox. A value outside the range Settings offers refuses to start.
# NIGHTWARDEN_MAX_INVESTIGATIONS_PER_HOUR=10   # 1 to 100
# NIGHTWARDEN_CHECK_IN_AFTER_MS=1800000        # 5 minutes to 4 hours
# NIGHTWARDEN_MAX_RETRIES=3                    # 0 to 5
# NIGHTWARDEN_TOOL_CALL_CEILING_MS=600000      # 1 to 30 minutes
# NIGHTWARDEN_SANDBOX_IDLE_TIMEOUT_MS=3600000  # 15 minutes to 4 hours
# NIGHTWARDEN_SANDBOX_CPUS=2                   # 1 to 8
# NIGHTWARDEN_SANDBOX_MEMORY_MB=4096           # 1024 to 16384
# NIGHTWARDEN_SANDBOX_NETWORK=allowlist        # allowlist | open | none

# Comma-separated hostnames. This is the whole list: it replaces the built-in hosts.
# NIGHTWARDEN_SANDBOX_ALLOWLIST_HOSTS=registry.npmjs.org,pypi.org

# NIGHTWARDEN_PORT=3000
# NIGHTWARDEN_HOST=127.0.0.1                   # 0.0.0.0 accepts off-host traffic

# Runners dial back here and Alertmanager posts here, so localhost is not it.
# Default: the request's own origin, which is wrong behind a proxy.
# NIGHTWARDEN_PUBLIC_URL=

# Comma-separated addresses a person may sign in from, beside NIGHTWARDEN_PUBLIC_URL.
# NIGHTWARDEN_TRUSTED_ORIGINS=

# All durable state: nightwarden.db, secret.key, auth.key, workspaces/, proxy/.
# Default: ~/.nightwarden. Absolute paths only.
# NIGHTWARDEN_DIR=

# Encrypts every stored credential. Default: generated into NIGHTWARDEN_DIR/secret.key.
# Losing it makes them unreadable. NIGHTWARDEN_SECRET_KEY_FILE reads it from a file.
# NIGHTWARDEN_SECRET_KEY=

# Signs session tokens. Default: generated into NIGHTWARDEN_DIR/auth.key. Changing it
# signs everyone out. NIGHTWARDEN_AUTH_SECRET_FILE reads it from a file.
# NIGHTWARDEN_AUTH_SECRET=

# Directory holding the built frontend, for an unusual layout. Default: beside the API bundle.
# NIGHTWARDEN_FRONTEND_DIST=

# Evidence integrations, saved on first boot only and without a probe; Test
# connection on the integration page checks one. After that the frontend owns them.
# PROMETHEUS_URL=
# PROMETHEUS_AUTH_HEADER=          # verbatim Authorization value, stored encrypted
# LOKI_URL=
# LOKI_AUTH_HEADER=
# LOKI_ORG_ID=                     # X-Scope-OrgID, multi-tenant Loki only

# NIGHTWARDEN_LOG_LEVEL=info                   # debug | info | warn | error

# Runner images the frontend's install artifacts hand out, one per platform;
# override to pin a tag or use a private registry.
# NIGHTWARDEN_DOCKER_RUNNER_IMAGE=ghcr.io/prabhatmattoo/nightwarden-docker-runner:latest
# NIGHTWARDEN_KUBERNETES_RUNNER_IMAGE=ghcr.io/prabhatmattoo/nightwarden-kubernetes-runner:latest
