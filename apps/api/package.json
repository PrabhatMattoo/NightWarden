    "@fastify/websocket": "11.3.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.165",
    "argon2": "0.44.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.25",
    "better-sqlite3": "12.11.1",
