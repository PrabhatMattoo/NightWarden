# Copy to apps/runners/kubernetes/.env for `pnpm dev:kubernetes-runner`, which uses your
# kubeconfig context. A deployed runner gets every value from its manifest instead.

# Mint one in the frontend under Integrations -> Kubernetes clusters. Shown once,
# stored hashed. A token minted for a Docker host is refused by this binary.
NIGHTWARDEN_TOKEN=nwr_local

# Every API route lives under /api. Use wss:// against an HTTPS install.
NIGHTWARDEN_WS_URL=ws://localhost:3000/api/clients/connect

# NIGHTWARDEN_LOG_LEVEL=info                   # debug | info | warn | error

# In-cluster the runner uses its ServiceAccount; from source it loads the default
# kubeconfig, so `kubectl config current-context` is the cluster it will report on.
