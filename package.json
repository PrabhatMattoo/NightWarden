{
  "name": "nightwarden",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "generate": "pnpm --filter @nightwarden/api generate",
    "pretypecheck": "pnpm generate",
    "typecheck": "pnpm -r typecheck",
    "prelint": "pnpm generate",
    "lint": "oxlint --type-aware --deny-warnings",
    "pretest": "pnpm generate",
    "test": "vitest run",
    "predev": "pnpm generate",
    "dev": "pnpm --filter @nightwarden/api --filter @nightwarden/frontend --parallel dev",
    "dev:docker-runner": "pnpm --filter @nightwarden/docker-runner dev",
    "dev:kubernetes-runner": "pnpm --filter @nightwarden/kubernetes-runner dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.17",
    "@types/dockerode": "4.0.1",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "knip": "6.45.1",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
