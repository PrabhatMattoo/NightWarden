{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The .claude/skills/playwright-cli skill drives it from the shell.
  "ignoreDependencies": ["@playwright/cli"],
  // A Windows-only branch in secrets.ts shells out to it.
  "ignoreBinaries": ["icacls"],
  // These files came from shadcn and stay a complete component kit.
  "ignoreIssues": {
    // Generated by kysely-codegen, which exports a type per table.
    "apps/api/src/database.ts": ["exports", "types"],
    "apps/frontend/src/shared/ui/checkbox.tsx": ["exports", "types"],
    "apps/frontend/src/shared/ui/dialog.tsx": ["exports", "types"],
    "apps/frontend/src/shared/ui/input-group.tsx": ["exports", "types"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/api": {
      "entry": ["scripts/*.{ts,mjs}"],
      // pino-pretty is loaded by name as a pino transport, and the build copies
      // the frontend's bundle into the image.
      "ignoreDependencies": ["pino-pretty", "@nightwarden/frontend"]
    },
    // build-app.mjs leaves a package's own dependencies external, so the runner
    // image must declare what runner-core imports on its behalf.
    "apps/runners/*": {
      "ignoreDependencies": ["pino", "ws", "zod", "@types/ws"]
    }
  }
}
